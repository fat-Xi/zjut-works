<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>每日签到</title>
<style>
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:"Microsoft YaHei",sans-serif;background:#f2f6fb;color:#243447}.panel{width:min(92%,440px);padding:38px 36px 34px;background:#fff;border-radius:14px;box-shadow:0 12px 35px rgba(47,85,125,.14)}.badge{width:58px;height:58px;margin:0 auto 18px;display:grid;place-items:center;border-radius:50%;background:#e8f2ff;color:#2f80ed;font-size:28px}h1{margin:0;text-align:center;font-size:26px}.subtitle{margin:9px 0 28px;text-align:center;color:#718096;font-size:14px}label{display:block;margin:16px 0 7px;font-size:14px;font-weight:bold}input{width:100%;padding:12px 13px;border:1px solid #d8e0ea;border-radius:7px;font-size:15px;outline:none}input:focus{border-color:#2f80ed;box-shadow:0 0 0 3px rgba(47,128,237,.12)}button{width:100%;margin-top:25px;padding:13px;border:0;border-radius:7px;background:#2f80ed;color:#fff;font-size:16px;cursor:pointer}button:hover{background:#246dcc}.success{display:none;margin-top:18px;padding:12px;border-radius:7px;text-align:center;color:#207545;background:#eaf8ef;font-size:14px}
</style></head><body><main class="panel"><div class="badge">✓</div><h1>每日签到</h1><p class="subtitle">请填写信息完成今日签到</p><form id="signInForm"><label for="name">姓名</label><input id="name" name="name" type="text" placeholder="请输入姓名" required><label for="studentId">学号</label><input id="studentId" name="studentId" type="text" placeholder="请输入学号" required><button type="submit">立即签到</button></form><div id="success" class="success" role="status"></div></main>
<script>document.getElementById('signInForm').addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('name').value.trim(),success=document.getElementById('success');success.textContent=name+'，签到成功！';success.style.display='block';const button=this.querySelector('button');button.textContent='已完成签到';button.disabled=true;});</script></body></html>
